---
// Hero — BKFC raw energy × Anthropic refined minimalism
---

<section
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <!-- Warm near-black base -->
  <div class="absolute inset-0 bg-gradient-to-b from-brand-darker via-brand-dark to-brand-dark"></div>

  <!-- Anthropic-style warm coral radial glow -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-brand-gold/[0.06] rounded-full blur-[160px] pointer-events-none"
  ></div>

  <!-- BKFC-style: hard red vertical accent line left -->
  <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-transparent via-brand-red/60 to-transparent pointer-events-none"></div>

  <!-- Cinematic photo overlay -->
  <div
    class="absolute inset-0 bg-[url('/hero/fighter.jpg')] bg-cover bg-center opacity-[0.15] mix-blend-luminosity pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- Vignette -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background:radial-gradient(ellipse at center,transparent 0%,rgba(8,6,4,0.7) 100%);"
  ></div>

  <div
    class="relative z-10 max-w-6xl mx-auto px-6 sm:px-8 text-center pt-32 pb-24 sm:pt-40 sm:pb-32"
  >
    <div class="animate-fade-in-up">
      <!-- Eyebrow — Anthropic-clean pill -->
      <div
        class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full bg-brand-gold/10 border border-brand-gold/20 text-brand-gold font-bold text-[10px] tracking-[0.3em] uppercase mb-10"
      >
        <span
          class="w-1.5 h-1.5 bg-brand-gold rounded-full animate-pulse-gold"
        ></span>
        Architects of the Combat Economy
      </div>

      <!-- H1 — BKFC wide-condensed brutalism -->
      <h1
        class="text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] font-display font-black uppercase tracking-tighter leading-[0.82] mb-8"
      >
        Fighter First.
        <span class="block text-brand-gold">World Stage.</span>
      </h1>

      <!-- BKFC-style divider with red accent -->
      <div class="flex items-center justify-center gap-4 mb-8">
        <div class="h-[1px] w-16 bg-brand-red/50"></div>
        <span class="text-[9px] font-black uppercase tracking-[0.4em] text-brand-red">Southeast Asia · MMA · Kun Khmer · Grappling</span>
        <div class="h-[1px] w-16 bg-brand-red/50"></div>
      </div>

      <!-- Sub — Anthropic measured prose -->
      <p
        class="text-base sm:text-lg md:text-xl text-brand-muted font-medium max-w-2xl mx-auto leading-relaxed mb-12"
      >
        Southeast Asia's MMA talent agency and broadcast media house.
        Scouting elite fighters. Powering Khmer Flow Arena.
      </p>

      <!-- Dual CTA -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5">
        <a
          href="/apply"
          class="group bg-brand-gold text-white px-10 py-4 font-bold rounded-xl text-[11px] uppercase tracking-[0.25em] hover:bg-brand-gold-dim transition-all shadow-[0_20px_60px_rgba(207,102,73,0.3)] active:scale-95 flex items-center gap-3"
        >
          Apply for Representation
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="group-hover:translate-x-1 transition-transform"
            ><path d="m9 18 6-6-6-6"></path></svg
          >
        </a>
        <a
          href="/partner"
          class="px-10 py-4 font-bold rounded-xl text-[11px] uppercase tracking-[0.25em] border border-white/15 text-white/80 hover:text-white hover:border-brand-gold/30 hover:bg-brand-gold/5 transition-all active:scale-95"
        >
          Partner with Us
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll cue -->
  <div
    class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 text-white/20"
  >
    <span class="text-[9px] font-black uppercase tracking-[0.4em]">Scroll</span>
    <div class="w-[1px] h-8 bg-gradient-to-b from-white/20 to-transparent"></div>
  </div>
</section>
