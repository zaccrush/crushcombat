---
// Hero — text-forward minimal, Claude-style dark layout
---

<section class="relative min-h-screen flex items-center justify-center">
  <div class="absolute inset-0 bg-brand-darker"></div>

  <!-- Subtle warm glow — restrained -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-brand-gold/[0.04] rounded-full blur-[120px] pointer-events-none"
  ></div>

  <div
    class="relative z-10 max-w-4xl mx-auto px-6 sm:px-8 text-center pt-32 pb-24 sm:pt-44 sm:pb-32"
  >
    <!-- Eyebrow label -->
    <p class="text-brand-gold text-[11px] font-bold uppercase tracking-[0.35em] mb-8 animate-fade-in-up">
      Architects of the Combat Economy
    </p>

    <!-- H1 — clear, high-contrast -->
    <h1
      class="text-4xl sm:text-6xl md:text-7xl font-display font-black tracking-tight leading-[1.05] mb-6 animate-fade-in-up delay-100"
    >
      Fighter First.<br />
      <span class="text-brand-gold">World Stage.</span>
    </h1>

    <!-- Descriptor line -->
    <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-white/30 mb-8 animate-fade-in-up delay-200">
      Southeast Asia · MMA · Kun Khmer · Grappling
    </p>

    <!-- Body -->
    <p
      class="text-base sm:text-lg text-white/60 font-medium max-w-xl mx-auto leading-relaxed mb-12 animate-fade-in-up delay-300"
    >
      Southeast Asia's MMA talent agency and broadcast media house.
      Scouting elite fighters. Powering Khmer Flow Arena.
    </p>

    <!-- CTA pair -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-in-up delay-400">
      <a
        href="/apply"
        class="bg-brand-gold text-white px-8 py-3.5 font-bold rounded-lg text-[11px] uppercase tracking-[0.2em] hover:bg-brand-gold-dim transition-colors shadow-[0_8px_32px_rgba(207,102,73,0.25)] active:scale-95 flex items-center gap-2"
      >
        Apply for Representation
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </a>
      <a
        href="/partner"
        class="px-8 py-3.5 font-bold rounded-lg text-[11px] uppercase tracking-[0.2em] border border-white/10 text-white/60 hover:text-white hover:border-white/20 transition-colors active:scale-95"
      >
        Partner with Us
      </a>
    </div>
  </div>

  <!-- Scroll cue -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/20">
    <span class="text-[9px] font-bold uppercase tracking-[0.4em]">Scroll</span>
    <div class="w-px h-8 bg-gradient-to-b from-white/20 to-transparent"></div>
  </div>
</section>
