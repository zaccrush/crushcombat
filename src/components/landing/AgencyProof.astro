---
// Agency Proof — KPI band + partner strip
---

<section class="py-20 sm:py-24 border-y border-white/5">
  <div class="max-w-5xl mx-auto px-6 sm:px-8">
    <!-- KPI tiles -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 sm:gap-16">
      {
        [
          { value: "100+", label: "Fighters Represented", accent: true },
          { value: "12+", label: "Countries Sourced", accent: false },
          { value: "3", label: "Disciplines · MMA · Kun Khmer · Grappling", accent: false },
        ].map((kpi) => (
          <div class="text-center md:text-left">
            <div class={`text-6xl sm:text-7xl font-display font-black leading-none tracking-tight mb-3 ${kpi.accent ? 'text-brand-gold' : 'text-white'}`}>
              {kpi.value}
            </div>
            <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/40">
              {kpi.label}
            </div>
          </div>
        ))
      }
    </div>

    <!-- Partner strip -->
    <div class="mt-16 pt-12 border-t border-white/5 flex flex-col sm:flex-row items-center gap-6 sm:gap-10">
      <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/30">Powering</span>
      <a
        href="https://khmerflow.com"
        target="_blank"
        rel="noopener"
        class="text-sm font-bold uppercase tracking-widest text-white/60 hover:text-white transition-colors"
      >
        Khmer Flow Arena
      </a>
      <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/20 border border-white/10 px-3 py-1 rounded-full">
        + Future Promotions
      </span>
    </div>
  </div>
</section>
