---
// Upcoming Fights — clean event list
const events = [
  {
    promotion: "Khmer Flow Arena",
    title: "KFA 03 — TBA",
    date: "TBA",
    venue: "Phnom Penh, Cambodia",
    status: "ANNOUNCED",
  },
];
---

<section class="py-24 sm:py-32 border-t border-white/5">
  <div class="max-w-5xl mx-auto px-6 sm:px-8">
    <div class="mb-12">
      <p class="text-brand-gold text-[11px] font-bold uppercase tracking-[0.35em] mb-4">Upcoming</p>
      <h2 class="text-3xl sm:text-4xl font-display font-black tracking-tight">
        Next On The Card.
      </h2>
    </div>

    <div class="space-y-3">
      {
        events.map((e) => (
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-6 border border-white/8 rounded-lg bg-white/[0.02] hover:border-white/15 transition-colors">
            <div>
              <div class="flex items-center gap-3 mb-2">
                <span class="text-[9px] font-bold uppercase tracking-[0.3em] text-brand-gold border border-brand-gold/30 px-2.5 py-1 rounded">
                  {e.status}
                </span>
                <span class="text-[10px] font-medium uppercase tracking-widest text-white/30">
                  {e.promotion}
                </span>
              </div>
              <h3 class="text-xl sm:text-2xl font-display font-black tracking-tight text-white mb-1">
                {e.title}
              </h3>
              <p class="text-sm text-white/40">
                {e.date} · {e.venue}
              </p>
            </div>
            <a
              href="/events"
              class="shrink-0 px-5 py-2.5 text-[10px] font-bold uppercase tracking-[0.2em] border border-white/10 text-white/60 hover:text-white hover:border-white/20 transition-colors rounded-lg"
            >
              Details
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
